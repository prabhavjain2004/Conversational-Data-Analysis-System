# ═══════════════════════════════════════════════════════════════════════
#  CDAS Configuration Template
# ═══════════════════════════════════════════════════════════════════════

# Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Classic SDK and New SDK supported)
# Options: gemini-3.0-flash, gemini-1.5-pro, etc.
LLM_MODEL=gemini-3.0-flash

# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Data Cleaning Thresholds & Limits
MAX_FILE_SIZE_MB=50
FK_OVERLAP_THRESHOLD=0.5

# Conversational Memory (Maximum turns to retain in sliding window)
# 1 turn = 1 user message + 1 assistant message
CONVERSATION_WINDOW_SIZE=5

# Logging level (Options: DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# CORS Allowed Origins (Comma-separated list or JSON-formatted array)
CORS_ORIGINS=["http://localhost:3000"]
