# ─── LLM ───────────────────────────────────────────────
GEMINI_API_KEY=your_key_here
LLM_MODEL=gemini-3.0-flash

# ─── Backend ───────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
MAX_FILE_SIZE_MB=50
FK_OVERLAP_THRESHOLD=0.5

# ─── Memory ────────────────────────────────────────────
CONVERSATION_WINDOW_SIZE=5

# ─── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://backend:8000
FRONTEND_PORT=3000

# ─── CORS ──────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
